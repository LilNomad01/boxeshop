# ============ EcomHub ============
# Pegue no painel da EcomHub
ECOMHUB_TOKEN=seu_token_aqui
ECOMHUB_SECRET=seu_secret_aqui
ECOMHUB_BASE_URL=https://api.ecomhub.app

# ============ Supabase ============
# Pegue em https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxx...
SUPABASE_SERVICE_ROLE_KEY=eyJxxx...

# ============ App ============
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ============ Facebook Tracking ============
# Pixel ID (público) - pegue no Facebook Events Manager
NEXT_PUBLIC_FB_PIXEL_ID=seu_pixel_id_aqui
# Access Token da Conversions API (privado) - pegue no Facebook Business Manager
FB_ACCESS_TOKEN=seu_access_token_aqui
# Código de teste (opcional) - use apenas para testar eventos no Events Manager
# FB_TEST_EVENT_CODE=TEST12345

# ============ Utmify Tracking ============
# Token da API Utmify - pegue no dashboard da Utmify
UTMIFY_API_TOKEN=seu_token_utmify_aqui
